{
  "compilerOptions": {
    "types": ["dom-speech-recognition"],
    "target":            "ES2020",
    "module":            "ESNext",
    "lib":               ["ES2020", "DOM"],
    "strict":            true,
    "esModuleInterop":   true,
    "skipLibCheck":      true,
    "moduleResolution":  "bundler",
    "declaration":       true,
    "declarationMap":    true,
    "sourceMap":         true,
    "noEmit":            true
  },
  "include": ["config/**/*", "sdk/**/*", "types/**/*", "lib/**/*"]
}
