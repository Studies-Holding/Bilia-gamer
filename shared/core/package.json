{
  "name": "@shared/core",
  "version": "0.1.0",
  "private": true,
  "description": "Socle backend partagé AFG : logger, middleware, erreurs, types, taxonomies, thèmes, utils, event bus.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./logger": "./dist/logger/logger.js",
    "./httpLogger": "./dist/logger/httpLogger.js",
    "./middleware/*": "./dist/middleware/*.js",
    "./errors": "./dist/errors/index.js",
    "./types": "./dist/types/index.js",
    "./taxonomies/*": "./dist/taxonomies/*.js",
    "./themes/*": "./dist/themes/*.js",
    "./utils/*": "./dist/utils/*.js",
    "./eventBus": "./dist/eventBus/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "echo \"@shared/core: no linter configured yet\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "dependencies": {
    "winston": "^3.17.0",
    "ioredis": "^5.4.2",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.13.2",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "~6.0.2"
  }
}
