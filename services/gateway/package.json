{
  "name": "gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Routage, auth edge, rate-limit, agrégation (cf. AFG-DT-001 §3).",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch & node --watch dist/index.js",
