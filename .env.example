# Environnement de développement — AFG / Bilibilia
# Copier en .env (non commité) et ajuster si besoin. Chaque service pourra avoir
# son propre .env.example une fois créé (cf. gabarit scripts/create-service.mjs).

NODE_ENV=development

# --- Mongo (1 base logique par service, même instance en dev — cf. docker-compose.yml) ---
MONGO_ROOT_USER=bilia
MONGO_ROOT_PASSWORD=bilia_dev_only
MONGO_HOST=localhost
MONGO_PORT=27017
# Exemple par service : mongodb://bilia:bilia_dev_only@localhost:27017/identity?authSource=admin

# --- Redis (cache, présence, rate-limit, event bus Redis Streams) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Mailhog (capture des emails de notification-service en dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Auth (identity-service, Lot 1) ---
JWT_ACCESS_SECRET=change_me_dev_only
JWT_REFRESH_SECRET=change_me_dev_only

# --- Gateway ---
GATEWAY_PORT=5000

# --- Mobile Money / PSP : différé, cf. AFG-DT-000 §7 et AFG-DT-004 §5 ---
# PSP_PROVIDER=
# PSP_API_KEY=
