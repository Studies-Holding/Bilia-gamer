    "chokidar":            "^3.6.0",
    "open":                "^10.1.0",
    "chalk":               "^5.3.0",
    "qrcode-terminal":     "^0.12.0",
    "ws":                  "^8.18.0"
  },
  "devDependencies": {
    "@types/node":    "^20.14.2",
    "typescript":     "^5.4.5"
  }
}
