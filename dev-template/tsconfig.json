{
  "compilerOptions": {
    "target":            "ES2020",
    "module":            "nodenext",
    "lib":               ["ES2020", "DOM"],
    "strict":            true,
    "esModuleInterop":   true,
    "skipLibCheck":      true,
    "moduleResolution":  "nodenext",
    "outDir":            "./dist",
    "rootDir":           "./src",
    "declaration":       true,
    "sourceMap":         true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
